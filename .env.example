# ─── Ticketing System Root Environment Variables ──────────────────────────────
# Used by docker-compose.yml

# Port nginx will listen on (accessible from your network)
APP_PORT=3002

# Admin panel password (passed to backend container)
ADMIN_PASSWORD=your_secure_password_here

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Required for connecting the backend to your Supabase project.
# You can find these in your Supabase project settings under API and Database.

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SECRET_KEY=eyJ...[YOUR-SERVICE-ROLE-JWT]...
SUPABASE_STORAGE_BUCKET=attachments
