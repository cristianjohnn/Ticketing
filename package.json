{
  "name": "ticketing",
  "version": "1.0.0",
  "description": "IT Support Ticketing System - Monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "start": "npm --prefix backend run start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cristian-John/Ticketing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Cristian-John/Ticketing/issues"
  },
  "homepage": "https://github.com/Cristian-John/Ticketing#readme",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
