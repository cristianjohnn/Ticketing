# IT Support Ticketing System Backend Variables

# Port Express backend will listen on inside the container
PORT=3000

# Node Environment (production / development)
NODE_ENV=production

# Admin panel authentication password
ADMIN_PASSWORD=your_secure_password_here

# SQLite Database storage path (for local dev, defaults to tickets.db in project root)
# DB_PATH=tickets.db

# ─── Supabase Configuration ───────────────────────────────────────────────────
# Required for connecting the backend to your Supabase project.
# You can find these in your Supabase project settings under API and Database.

DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SECRET_KEY=eyJ...[YOUR-SERVICE-ROLE-JWT]...
SUPABASE_STORAGE_BUCKET=attachments

# ─── Caching & Infrastructure ──────────────────────────────────────────────────
# Provider can be 'redis' or 'memory' (fallback for dev without Docker)
CACHE_PROVIDER=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Time-To-Live settings in seconds
CACHE_DEFAULT_TTL=300
CACHE_STATS_TTL=60
CACHE_ANALYTICS_TTL=120
CACHE_TICKETS_TTL=30

# Advanced Cache Configs
CACHE_COMPRESSION_ENABLED=true
CACHE_COMPRESSION_THRESHOLD=10240
CACHE_WARMUP=true
CACHE_VERSION=v1
